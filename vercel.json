{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/Homepage.php", "destination": "/index.html" },
    { "source": "/ProductPage.php", "destination": "/ProductPage.html" },
    { "source": "/ProductDescription.php", "destination": "/ProductDescription.html" },
    { "source": "/:path*.php", "destination": "/unavailable.html" }
  ]
}
